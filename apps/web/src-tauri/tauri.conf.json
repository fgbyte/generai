{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "generai",
  "version": "0.1.0",
  "identifier": "com.generai.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "generai",
        "width": 576,
        "height": 900,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://fonts.gstatic.com https://fonts.googleapis.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:3001"
    }
  },
  "bundle": {
    "android": {
      "versionCode": 100,
      "minSdkVersion": 28
    },
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
