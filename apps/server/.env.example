BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

#Google Oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postmark Server API Token - get it at https://postmarkapp.com
POSTMARK_SERVER_TOKEN=
# Email address to send from (must have verified sender signature in Postmark)
POSTMARK_FROM_EMAIL=

# AI Services
# Primary provider (NVIDIA) - required
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# Optional provider: Groq (used as fallback when configured)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional provider: Gemini (used as fallback when configured)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=gemini-2.5-flash

# If going to use local postrgress for dev Else just use neon
DATABASE_URL=postgresql://user:password@localhost:5432/todos

# Telegram Bot (for feedback notifications)
# Create your bot via @BotFather on Telegram, get the token there.
# Get CHAT_ID: send /start to your bot, then visit
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates and look for chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
