{
  "name": "generai",
  "version": "0.1.0",
  "private": false,
  "description": "AI-powered social media content generation platform with multi-platform scheduling",
  "homepage": "https://github.com/fgbyte/generai#readme",
  "bugs": {
    "url": "https://github.com/fgbyte/generai/issues"
  },
  "license": "MIT",
  "author": "fgbyte",
  "repository": {
    "type": "git",
    "url": "https://github.com/fgbyte/generai.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "hono": "^4.12.26",
      "typescript": "^6.0.3",
      "@types/node": "^25.9.3",
      "@cloudflare/workers-types": "^4.20260621.1",
      "better-auth": "^1.6.20",
      "alchemy": "^0.93.12",
      "vitest": "^4.1.9",
      "@vitest/ui": "^4.1.9",
      "@vitest/coverage-v8": "^4.1.9",
      "jsdom": "^29.1.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:desk": "turbo -F web tauri:build",
    "build:android": "cd apps/web && VITE_SERVER_URL=https://generai-server-staging.fgbyte.workers.dev bun run android:build-debug",
    "build:phone": "cd apps/web && VITE_SERVER_URL=https://generai-server-staging.fgbyte.workers.dev bun run android:build-release-phone",
    "dev": "turbo -F @generai/infra dev",
    "dev:native": "turbo -F native dev",
    "dev:web": "VITE_SERVER_URL=https://generai-server-dev.fgbyte.workers.dev turbo -F web dev",
    "dev:desk": "turbo -F web tauri:dev",
    "dev:android": "cd apps/web && bun run android:dev",
    "dev:server": "turbo -F server dev",
    "deploy:dev": "bun run --filter @generai/infra deploy:dev",
    "deploy:staging": "bun run --filter @generai/infra deploy:staging",
    "deploy:prod": "bun run --filter @generai/infra deploy:prod",
    "destroy:dev": "bun run --filter @generai/infra destroy:dev",
    "destroy:staging": "bun run --filter @generai/infra destroy:staging",
    "destroy:prod": "bun run --filter @generai/infra destroy:prod",
    "check-types": "turbo check-types",
    "db:studio": "turbo -F @generai/db db:studio",
    "db:generate": "turbo -F @generai/db db:generate",
    "db:migrate": "turbo -F @generai/db db:migrate",
    "db:migrate-staging": "turbo -F @generai/db db:migrate-staging",
    "test": "turbo test --filter=web --filter=server",
    "test:server": "bun run --cwd apps/server test",
    "test:web": "bun run --cwd apps/web test",
    "open-auth-docs": "open-cli http://localhost:3000/api/auth/reference",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@generai/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@generai/config": "workspace:*",
    "@types/node": "catalog:",
    "open-cli": "^9.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "overrides": {
    "@babel/generator": "7.29.7",
    "@babel/parser": "7.29.7",
    "@babel/types": "7.29.7",
    "kysely": "0.29.2"
  },
  "packageManager": "bun@1.3.10"
}
